uniform float3 directionalLight;
uniform float3 lightColor;

struct C2E1v_Output {
    float4 position : POSITION;
    float4 color    : COLOR;
    float2 uv       : TEXCOORD0;
    float3 worldPos : TEXCOORD1;
    float3 normal   : TEXCOORD2;
};

C2E1v_Output main(float4 inPos : POSITION,
                  float4 inColor : COLOR,
                  float2 inUV : TEXCOORD0)
{
    C2E1v_Output o;

    float3 N = float3(0,1,0);
    float3 L = normalize(directionalLight);

    float NdotL = max(dot(N, L), 0.0);
    float3 lit = lightColor * NdotL;

    o.position = inPos;
    o.uv = inUV;
    o.worldPos = inPos.xyz;
    o.normal = N;

    float3 col = inColor.rgb * lit;
    col = saturate(col);
    col = pow(col, 1.0/2.2);

    o.color = float4(col, 1.0);

    return o;
}
