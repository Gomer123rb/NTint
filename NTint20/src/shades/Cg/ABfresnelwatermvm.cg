static const float WaveAmp  = 0.15;
static const float WaveFreq = 4.0;
static const float WaveSpeed = 1.5;

uniform float Time;

struct C2E1v_Output {
    float4 position : POSITION;
    float4 color    : COLOR;
    float2 uv       : TEXCOORD0;

    float3 worldPos : TEXCOORD1;
    float3 normal   : TEXCOORD2;
};
 
C2E1v_Output main(
    float4 inPos   : POSITION,
    float4 inColor : COLOR,
    float2 inUV    : TEXCOORD0
)
{
    C2E1v_Output OUT;

    float3 p = inPos.xyz;

    float wave =
        sin(p.x * WaveFreq + Time * WaveSpeed) +
        cos(p.z * WaveFreq * 0.7 + Time * WaveSpeed * 1.3);

    p.y += wave * WaveAmp;

    OUT.position = float4(p, 1.0);
    OUT.color    = inColor;
    OUT.uv       = inUV;

    OUT.worldPos = p;
    OUT.normal   = float3(0.0, 1.0, 0.0);

    return OUT;
}

